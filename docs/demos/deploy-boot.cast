[7.057249, "o", "\r\u001b[2K\u001b[1mDeploying 1 host:\u001b[0m db1\r\n\r\n\u001b[32m\u001b[1m\u283c \u25b6 Deploy\u001b[0m\u001b[2m \u00b7 1 host \u00b7 1 queued\u001b[0m  \u001b[32m\u2578\u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m 0% \u001b[2m00:00:00\u001b[0m                                    \r\u001b[2K\u001b[32m\u001b[1m\u283c \u25b6 Deploy\u001b[0m\u001b[2m \u00b7 1 host \u00b7 1 queued\u001b[0m  \u001b[32m\u2578\u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m 0% \u001b[2m00:00:00\u001b[0m\r\n\u001b[2m  \u2713 Done\u001b[0m                                                                                            "]
[7.057731, "o", "\u001b[1A\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1A\u001b[32m\u001b[1m\u283c \u25b6 Deploy\u001b[0m\u001b[2m \u00b7 1 host \u00b7 1 queued\u001b[0m  \u001b[32m\u2578\u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m 0% \u001b[2m00:00:00\u001b[0m\r\n\u001b[2m  \u2713 Done\u001b[0m\r\n\u001b[2m  \u2717 Failed\u001b[0m                                                                                          \u001b[2A\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[2A\u001b[32m\u001b[1m\u283c \u25b6 Deploy\u001b[0m\u001b[2m \u00b7 1 host \u00b7 1 queued\u001b[0m  \u001b[32m\u2578\u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m 0% \u001b[2m00:00:00\u001b[0m\r\n\u001b[2m  \u27f3 Reboot\u001b[0m\r\n\u001b[2m  \u2713 Done\u001b[0m\r\n\u001b[2m  \u2717 Failed\u001b[0m                                                                                          \u001b[3A\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[3A\u001b[32m\u001b[1m\u283c \u25b6 Deploy\u001b[0m\u001b[2m \u00b7 1 host \u00b7 1 queued\u001b[0m  \u001b[32m\u2578\u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m 0% \u001b[2m00:00:00\u001b[0m\r\n\u001b[2m  \u2605 Activate\u001b[0m\r\n\u001b[2m  \u27f3 Reboot\u001b[0m\r\n\u001b[2m  \u2713 Done\u001b[0m\r\n\u001b[2m  \u2717 Failed\u001b[0m                                                                                          \u001b[4A\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[4A\u001b[32m\u001b[1m\u283c \u25b6 Deploy\u001b[0m\u001b[2m \u00b7 1 host \u00b7 1 queued\u001b[0m  \u001b[32m\u2578\u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2