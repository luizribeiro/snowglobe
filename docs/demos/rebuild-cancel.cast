[3.723234, "o", "\u001b[5A\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\u001b[5A\u001b[32m\u2714\u001b[0m \u001b[1mWhat now?\u001b[0m \u001b[38;5;8m\u00b7\u001b[0m \u001b[32mSwitch now, reboot later\u001b[0m\r\n\u001b[?25h\u001b[?25l\r\n\u001b[33m\u001b[1m!\u001b[0m Until you reboot, the running system mixes old and new parts, and\r\n  anything that depends on both may misbehave.\r\n\u001b[?25h\u001b[33m?\u001b[0m \u001b[1mSwitch anyway?\u001b[0m \u001b[38;5;8m(y/n)\u001b[0m \u001b[38;5;8m\u203a\u001b[0m \u001b[36mno\u001b[0m"]
